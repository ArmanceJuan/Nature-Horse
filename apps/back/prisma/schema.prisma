generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  STAFF
  CLIENT
}

enum OrderStatus {
  PENDING
  READY_FOR_PICKUP
  PICKED_UP
  CANCELLED
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum AlertStatus {
  ACTIVE
  HANDLED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  role          Role           @default(CLIENT)
  otp_enable    Boolean        @default(false)
  otp_secret    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  a2fBackupCode A2FBackupCode?
  orders        Order[]
  stores        UserStore[]
}

model A2FBackupCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codesHash Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id           String      @id @default(uuid())
  name         String
  address      String
  postalCode   String
  city         String
  phone        String?
  email        String?
  openingHours Json
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  stocks       Stock[]
  orders       Order[]
  staff        UserStore[]
}

model UserStore {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
}

model Attribute {
  id     String           @id @default(uuid())
  name   String           @unique
  values AttributeValue[]
}

model AttributeValue {
  id          String                         @id @default(uuid())
  attributeId String
  attribute   Attribute                      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  variants    ProductVariantAttributeValue[]

  @@unique([attributeId, value])
}

model Category {
  id        String    @id @default(uuid())
  slug      String    @unique
  name      String
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id           String           @id @default(uuid())
  slug         String           @unique
  name         String
  description  String           @db.Text
  price        Float
  collection   String
  discipline   String
  categoryId   String?
  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status       ProductStatus    @default(ACTIVE)
  specs        Json
  shippingInfo String           @db.Text
  isNew        Boolean          @default(false)
  isPopular    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  images       ProductImage[]
  variants     ProductVariant[]

  @@index([categoryId])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductVariant {
  id              String                         @id @default(uuid())
  productId       String
  product         Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String?                        @unique
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  attributeValues ProductVariantAttributeValue[]
  stocks          Stock[]
  orderItems      OrderItem[]
}

model ProductVariantAttributeValue {
  id               String         @id @default(uuid())
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, attributeValueId])
}

model Stock {
  id               String         @id @default(uuid())
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  storeId          String
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  quantity         Int            @default(0)
  alertThreshold   Int            @default(5)
  updatedAt        DateTime       @updatedAt
  alerts           StockAlert[]

  @@unique([productVariantId, storeId])
}

model StockAlert {
  id         String      @id @default(uuid())
  stockId    String
  stock      Stock       @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockLevel Int
  status     AlertStatus @default(ACTIVE)
  createdAt  DateTime    @default(now())
  handledAt  DateTime?

  @@index([status])
}

model Order {
  id                String      @id @default(uuid())
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  storeId           String
  store             Store       @relation(fields: [storeId], references: [id])
  customerEmail     String
  customerFirstName String
  customerLastName  String
  customerPhone     String?
  trackingToken     String      @unique
  status            OrderStatus @default(PENDING)
  totalPrice        Float
  pickupReadyAt     DateTime
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]

  @@index([customerEmail])
}

model OrderItem {
  id               String         @id @default(uuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productName      String
  quantity         Int
  unitPrice        Float
}